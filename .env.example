# demo | statsbomb | sportmonks | skillcorner | wyscout
TACTISCOUT_DATA_MODE=demo

# Path to either the StatsBomb Open Data repository root or its data/ directory.
TACTISCOUT_STATSBOMB_DIR=./data/statsbomb-open-data
TACTISCOUT_STATSBOMB_COMPETITION_IDS=
TACTISCOUT_STATSBOMB_SEASON_IDS=
# Keep false until the User Agreement has been reviewed and local model processing is confirmed.
TACTISCOUT_STATSBOMB_AI_PROCESSING_ALLOWED=false

# Optional current player provider. Season IDs must be marked current by Sportmonks.
# Keep this token on the API server; do not place it in web/ configuration or logs.
SPORTMONKS_API_TOKEN=
TACTISCOUT_SPORTMONKS_SEASON_IDS=
# Only include statistic type IDs confirmed as covered by the configured account and league.
# Supported mappings: 52 goals, 79 assists, 80 passes, 81/116 completed passes,
# 78 tackles, 100 interceptions, 119 minutes played, 122 long balls.
TACTISCOUT_SPORTMONKS_COVERED_STATISTIC_TYPE_IDS=
# Must stay false until the configured provider terms/account permit model processing.
TACTISCOUT_SPORTMONKS_AI_PROCESSING_ALLOWED=false
# In-memory cache lifetime; default is 15 minutes.
TACTISCOUT_SPORTMONKS_CACHE_TTL_MS=

# Optional historical SkillCorner Open Data sample. Place the three aggregate CSVs
# in this local directory; the provider never downloads or bundles player data.
TACTISCOUT_SKILLCORNER_AGGREGATES_DIR=./.data/skillcorner-open-data/aggregates
# Enable only after confirming each use is permitted for the data you provide.
TACTISCOUT_SKILLCORNER_LOCAL_STORAGE_ALLOWED=false
TACTISCOUT_SKILLCORNER_AI_PROCESSING_ALLOWED=false
TACTISCOUT_SKILLCORNER_REPORT_DISPLAY_ALLOWED=false

# Optional historical Wyscout Open Data sample. Place manually obtained JSON files
# in this local directory; raw player/event data is never downloaded or committed.
TACTISCOUT_WYSCOUT_DIR=./.data/wyscout-open-data
# Comma-separated Wyscout club competition IDs; empty means all club competitions in the files.
TACTISCOUT_WYSCOUT_COMPETITION_IDS=
# Keep false until the configured local/remote model's use is explicitly confirmed.
TACTISCOUT_WYSCOUT_AI_PROCESSING_ALLOWED=false

# Optional JSON file keyed by StatsBomb player ID, e.g. {"12345":{"age":22,"source":"football-data.org"}}
TACTISCOUT_DEMOGRAPHICS_FILE=

# OpenAI-compatible conversation agent; credentials stay on the API server.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Maximum time per model decision (1000–600000 ms; default 180000); model calls do not retry implicitly.
OPENAI_TIMEOUT_MS=180000
# Optional model-specific reasoning control. Set to `none` for Ollama Qwen models.
OPENAI_REASONING_EFFORT=

# Local LangGraph checkpoints for paused recruitment cases (separate from browser localStorage plans).
# Keep the SQLite file on local disk for the single API process used by this prototype.
TACTISCOUT_CHECKPOINT_PATH=./.data/recruitment-cases.sqlite

# Local server-side RAG index and multilingual E5 ONNX q8 embedding model.
# Quantized model weights are downloaded and cached on first RAG query.
TACTISCOUT_KNOWLEDGE_DIR=./.data/knowledge
TACTISCOUT_KNOWLEDGE_SOURCES_FILE=./data/knowledge/sources.json
TACTISCOUT_PLAYER_OBSERVATIONS_PATH=./.data/player-observations.json
TACTISCOUT_EMBEDDING_MODEL=onnx-community/multilingual-e5-base-ONNX
# Optional remote embeddings. Local Transformers.js remains the default.
TACTISCOUT_EMBEDDING_PROVIDER=local
TACTISCOUT_EMBEDDING_API_KEY=
TACTISCOUT_EMBEDDING_BASE_URL=
TACTISCOUT_REMOTE_EMBEDDING_MODEL=text-embedding-3-small

HOST=127.0.0.1
PORT=8000
