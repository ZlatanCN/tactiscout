{
  "name": "tactiscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "pnpm --filter @tactiscout/web dev",
    "build": "tsc -p tsconfig.json",
    "build:web": "pnpm --filter @tactiscout/web build",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:local-agent": "node --import tsx src/evals/local-model-agent.ts",
    "knowledge:discover": "tsx src/knowledge/cli.ts discover",
    "knowledge:ingest": "tsx src/knowledge/cli.ts ingest",
    "knowledge:crawl": "tsx src/knowledge/cli.ts crawl",
    "knowledge:purge-source": "tsx src/knowledge/cli.ts purge-source",
    "identity:reep": "tsx src/identity/cli.ts",
    "dataset:build": "node --import tsx src/dataset/build-cli.ts",
    "dataset:refresh": "node --import tsx src/dataset/refresh-cli.ts",
    "dataset:refresh:skillcorner": "node --import tsx src/dataset/refresh-skillcorner-cli.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.6.0",
    "apache-arrow": "18.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
